<?xml version="1.0"?>
<!--
  controller.launch.xml

  Uruchamia glowny wezel sterownika pojazdu (cmd_vel_controller)
  z parametrami wczytanymi z config/controller_params.yaml.

  Uzycie:
    ros2 launch rc_car_controller controller.launch.xml

  Nadpisanie parametru z linii polecen, np. wylaczenie E-Stopu:
    ros2 launch rc_car_controller controller.launch.xml estop_enabled:=false
-->
<launch>

  <!-- ======= ARGUMENTY LAUNCHA ======= -->
  <arg name="params_file"
       default="$(find-pkg-share rc_car_controller)/config/controller_params.yaml"
       description="Sciezka do pliku YAML z parametrami sterownika"/>

  <arg name="can_interface" default="can0"
       description="Interfejs magistrali CAN (socketcan)"/>

  <arg name="estop_enabled" default="true"
       description="Wlacz/wylacz zatrzymanie awaryjne oparte o LiDAR"/>

  <arg name="use_sim_time" default="false"
       description="Uzyj czasu symulacyjnego (dla testow z bag/sim)"/>

  <!-- ======= WEZEL STEROWNIKA ======= -->
  <node pkg="rc_car_controller"
        exec="cmd_vel_controller"
        name="cmd_vel_controller"
        output="screen">

    <!-- Wczytaj wszystkie parametry z pliku YAML -->
    <param from="$(var params_file)"/>

    <!-- Nadpisania z argumentow launcha (maja pierwszenstwo) -->
    <param name="can_interface" value="$(var can_interface)"/>
    <param name="estop_enabled" value="$(var estop_enabled)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
