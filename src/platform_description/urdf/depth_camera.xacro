<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="camera_length" value="0.01" />
    <xacro:property name="camera_width" value="0.15" />
    <xacro:property name="camera_height" value="0.05" />


    <!-- LINKS -->
    <link name="depth_camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" l="${camera_length}" w="${camera_width}" h="${camera_height}"
                           xyz="0 0 0" rpy="0 0 0" />
    </link>    

    <link name="depth_camera_optical_link"/>

    <!-- JOINTS-->
    <joint name="depth_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="depth_camera_link"/>
        <origin xyz="${(base_length + camera_length) / 2.0} 0 ${base_height / 2.0}" rpy="0 0 0" />   
    </joint>

    <joint name="depth_camera_optical_joint" type="fixed">
        <parent link="depth_camera_link"/>
        <child link="depth_camera_optical_link"/>
        <origin xyz="0 0 0" rpy="${0} 0 ${0}"/>
    </joint>



    <gazebo reference="depth_camera_link">
        <sensor type="rgbd_camera" name="depth_camera_sensor">
        <topic>camera/image_raw</topic>
        <update_rate>20.0</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <gz_frame_id>depth_camera_optical_link</gz_frame_id>

        <camera name="depth_camera">
            <horizontal_fov>1.02974</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.02</near>
                <far>20</far>
            </clip>
            <depth_camera>
                <clip>
                    <near>0.02</near>
                    <far>20</far>
                </clip>
            </depth_camera>
        </camera>
    </sensor>
    </gazebo>

</robot>