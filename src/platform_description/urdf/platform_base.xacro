<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


<!-- ============================================== -->
<!-- ROBOT BASE (Main chassis body)                 -->
<!-- ============================================== -->
  <link name="base_footprint"/>

  <link name="base_link">
      <visual>
          <geometry>
              <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
          </geometry>
          <material name="red"/>
      </visual>
      <collision>
          <geometry>
              <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
          </geometry>
      </collision>
      <xacro:box_inertia m="2" l="${chassis_length}" w="${chassis_width}" h="${chassis_height}" xyz="0 0 0" rpy="0 0 0"/>
  </link>

  <joint name="base_footprint_base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

<!-- ============================================== -->
<!-- PLATFORM (Additional element on the chassis)   -->
<!-- ============================================== -->
  <link name="platform_link">
      <visual>
          <geometry> <box size="${platform_length} ${platform_width} ${platform_height}"/> </geometry>
          <material name="red"/>
      </visual>
      <collision>
          <geometry> <box size="${platform_length} ${platform_width} ${platform_height}"/> </geometry>
      </collision>
      <xacro:box_inertia m="${platform_mass}" l="${platform_length}" w="${platform_width}" h="${platform_height}" xyz="0 0 0" rpy="0 0 0"/>
  </link>

  <joint name="base_platform_joint" type="fixed">
      <parent link="base_link"/>
      <child link="platform_link"/>
      <origin xyz="${platform_offset_x} ${platform_offset_y} ${platform_offset_z}" rpy="0 0 0"/>
  </joint>


<!-- ============================================== -->
<!-- WHEEL AXLES (Connectors between base & wheels) -->
<!-- ============================================== -->
  <xacro:macro name="wheel_bar" params="prefix x_off length">
      <link name="${prefix}_wheel_bar">
          <visual>
              <geometry> <cylinder radius="${wheel_bar_radius}" length="${length}"/> </geometry>            
              <origin xyz="0.0 0.0 0.0" rpy="-1.57 0.0 0.0"/>
          </visual>
          <xacro:cylinder_inertia m="${wheel_bar_mass}" r="${wheel_bar_radius}" h="${length}" xyz="0 0 0" rpy="-1.57 0 0"/>
      </link>
      <joint name="base_${prefix}_wheel_bar" type="fixed">
          <parent link="base_link"/>
          <child link="${prefix}_wheel_bar"/>
          <origin xyz="${x_off} 0.0 0.0"/>
      </joint>
  </xacro:macro>

  <xacro:wheel_bar prefix="front" x_off="0.1575" length="0.190"/>
  <xacro:wheel_bar prefix="rear" x_off="-0.1725" length="0.220"/>

<!-- ============================================== -->
<!-- FRONT WHEELS (Includes steering mechanism)     -->
<!-- ============================================== -->
  <xacro:macro name="front_wheel" params="prefix x_off y_off">
      <link name="${prefix}_steering_link">
          <xacro:steering_inertia/>
      </link>

      <joint name="${prefix}_steering_joint" type="revolute">
          <parent link="base_link"/>
          <child link="${prefix}_steering_link"/>
          <origin xyz="${x_off} ${y_off} 0" rpy="0 0 0"/>
          <axis xyz="0 0 1"/>
          <limit effort="${max_steering_effort}" lower="${-max_steering_angle}" upper="${max_steering_angle}" velocity="${max_steering_angular_velocity}"/>
          <!-- <dynamics damping="0.1" friction="0.1"/> -->
      </joint>

      <link name="${prefix}_wheel_link">
          <visual>
              <geometry> <cylinder radius="${wheel_radius}" length="${wheel_width}"/> </geometry>
              <origin xyz="0 0 0" rpy="1.5708 0 0"/>
              <material name="black"/>
          </visual>
          <collision>
              <geometry> <sphere radius="${wheel_radius}"/> </geometry>
              <origin xyz="0 0 0" rpy="0 0 0"/>
          </collision>
           <xacro:cylinder_inertia m="0.2" r="${wheel_radius}" h="${wheel_width}" xyz="0 0 0" rpy="1.5708 0 0"/>
      </link>

      <joint name="${prefix}_wheel_joint" type="continuous">
          <parent link="${prefix}_steering_link"/>
          <child link="${prefix}_wheel_link"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <axis xyz="0 1 0"/>
          <limit effort="${max_effort}" velocity="${max_wheel_angular_velocity}"/>
          <!-- <dynamics damping="0.01" friction="0.01"/> -->
      </joint>

      <gazebo reference="${prefix}_wheel_link">
          <mu1>1.0</mu1>
          <mu2>0.85</mu2>  
          <fdir1>1 0 0</fdir1>
          <kp>10000000.0</kp>
          <kd>1.0</kd>
          <minDepth>0.001</minDepth>
          <material>Gazebo/Black</material>
      </gazebo>
  </xacro:macro>

  <xacro:front_wheel prefix="front_left"  x_off="0.1575" y_off="0.095"/>
  <xacro:front_wheel prefix="front_right" x_off="0.1575" y_off="-0.095"/>

<!-- ============================================== -->
<!-- REAR WHEELS (Drive only, no steering)          -->
<!-- ============================================== -->
  <xacro:macro name="rear_wheel" params="prefix x_off y_off">
      <link name="${prefix}_wheel_link">
          <visual>
              <geometry> <cylinder radius="${wheel_radius}" length="${wheel_width}"/> </geometry>
              <origin xyz="0 0 0" rpy="1.5708 0 0"/>
              <material name="black"/>
          </visual>
          <collision>
              <geometry> <sphere radius="${wheel_radius}"/> </geometry>
              <origin xyz="0 0 0" rpy="0 0 0"/>
          </collision>
           <xacro:cylinder_inertia m="0.2" r="${wheel_radius}" h="${wheel_width}" xyz="0 0 0" rpy="1.5708 0 0"/>
      </link>

      <joint name="${prefix}_wheel_joint" type="continuous">
          <parent link="base_link"/>
          <child link="${prefix}_wheel_link"/>
          <origin xyz="${x_off} ${y_off} 0" rpy="0 0 0"/>
          <axis xyz="0 1 0"/>
          <limit effort="${max_effort}" velocity="${max_wheel_angular_velocity}"/>
          <!-- <dynamics damping="0.01" friction="0.01"/> -->
      </joint>

      <gazebo reference="${prefix}_wheel_link">
          <mu1>1.0</mu1>
          <mu2>0.85</mu2>  
          <fdir1>1 0 0</fdir1>
          <kp>10000000.0</kp>
          <kd>1.0</kd>
          <minDepth>0.001</minDepth>
          <material>Gazebo/Black</material>
      </gazebo>
  </xacro:macro>

  <xacro:rear_wheel prefix="rear_left"   x_off="-0.1725" y_off="0.110"/>
  <xacro:rear_wheel prefix="rear_right"  x_off="-0.1725" y_off="-0.110"/>

  <gazebo reference="base_link"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="platform_link"><material>Gazebo/Red</material></gazebo>

</robot>