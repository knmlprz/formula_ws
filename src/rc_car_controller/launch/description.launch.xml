<?xml version="1.0"?>
<!--
  description.launch.xml

  Publikuje opis robota (URDF) na /robot_description oraz statyczne
  transformacje kol/lidaru poprzez robot_state_publisher.
  Opcjonalnie uruchamia joint_state_publisher i RViz2.

  Uzycie:
    ros2 launch rc_car_controller description.launch.xml
    ros2 launch rc_car_controller description.launch.xml gui:=true rviz:=true
-->
<launch>

  <arg name="model"
       default="$(find-pkg-share rc_car_controller)/description/urdf/rc_car.urdf.xacro"
       description="Sciezka do pliku URDF/xacro pojazdu"/>

  <arg name="gui" default="false"
       description="Uruchom joint_state_publisher_gui (suwaki stawow)"/>

  <arg name="jsp" default="false"
       description="Uruchom joint_state_publisher (wymaga ros-jazzy-joint-state-publisher). Domyslnie OFF - nie jest potrzebny do jazdy/SLAM."/>

  <arg name="rviz" default="false"
       description="Uruchom RViz2 z konfiguracja podgladu"/>

  <!-- robot_state_publisher: publikuje TF na podstawie URDF -->
  <node pkg="robot_state_publisher"
        exec="robot_state_publisher"
        name="robot_state_publisher"
        output="screen">
    <param name="robot_description"
           value="$(command 'xacro $(var model)')"
           type="str"/>
  </node>

  <!-- joint_state_publisher (bez GUI) - publikuje stany stawow kol.
       Opcjonalny: potrzebny tylko do wizualizacji obrotu kol w RViz. -->
  <node pkg="joint_state_publisher"
        exec="joint_state_publisher"
        name="joint_state_publisher"
        if="$(var jsp)"/>

  <!-- joint_state_publisher_gui - z suwakami (do debugu) -->
  <node pkg="joint_state_publisher_gui"
        exec="joint_state_publisher_gui"
        name="joint_state_publisher_gui"
        if="$(var gui)"/>

  <!-- RViz2 (opcjonalnie) -->
  <node pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        args="-d $(find-pkg-share rc_car_controller)/description/rviz/rc_car.rviz"
        if="$(var rviz)"/>

</launch>
