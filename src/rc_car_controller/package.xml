<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rc_car_controller</name>
  <version>1.0.0</version>
  <description>
    Sterownik pojazdu RC (model Ackermanna) dla ROS2 Jazzy.
    Przetwarza cmd_vel (Twist) oraz TwistStamped na sterowanie serwem
    (uklad kierowniczy) i silnikami ODrive (naped przez CAN).
    Publikuje odometrie kolowa i transformacje TF odom->base_link.
    Zawiera zatrzymanie awaryjne (E-Stop) oparte o LiDAR.
  </description>

  <maintainer email="msurowka@example.com">msurowka</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Zaleznosci uruchomieniowe (ROS) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Zaleznosci opisu robota / launcha -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Opcjonalne (tylko do wizualizacji obrotu kol w RViz):
       ros-jazzy-joint-state-publisher, ros-jazzy-joint-state-publisher-gui -->

  <!-- Zaleznosci Python spoza ROS (instalowane pip/apt):
       python3-can, gpiozero, lgpio -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
